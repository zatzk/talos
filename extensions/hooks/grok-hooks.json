{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "talos-cli session signal --state idle >/dev/null 2>&1 || true  # managed by talos `extension install` — do not edit",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "talos-cli session signal --state working >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "talos-cli session signal --state working >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "talos-cli session signal --state working >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if cat | sed -n 's/.*\"message\":\"\\([^\"]*\\)\".*/\\1/p' | grep -qiE 'permission|approval|approve'; then talos-cli session signal --state blocked >/dev/null 2>&1 ; fi; true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "talos-cli session signal --state done >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
