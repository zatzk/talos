# Talos — decision engine (Jev) configuration.
# Copy to your shell environment (~/.profile, ~/.bashrc, or a systemd unit) or
# export before running talos. Every variable is OPTIONAL: with no key the
# engine answers from its deterministic heuristics (provider:
# heuristic-fallback), so talos never blocks on the network.

# OpenRouter API key — enables the Jev decision endpoint (typesafe/jev-1.13).
# export OPENROUTER_API_KEY="sk-or-v1-..."

# Decision endpoint override (default: https://openrouter.ai/api/alpha/decisions)
# export DECISIONS_ENDPOINT="https://openrouter.ai/api/alpha/decisions"

# Decision model override (default: typesafe/jev-1.13)
# export JEV_MODEL="typesafe/jev-1.13"

# Decision timeout in milliseconds (default: 6000)
# export JEV_TIMEOUT_MS="6000"

# Control-plane checkout the lead session opens (default: ~/Code/code-documentation)
# export TALOS_CONTROL_PLANE="/home/you/Code/code-documentation"

# Agent the lead session launches (a name from ~/.config/talos/agents.toml;
# default: claude). antigravity/opencode/codex/aider are also built in.
# export TALOS_LEAD_AGENT="claude"
