<?xml version="1.0" encoding="utf-8"?>
<!--
  Chocolatey package for talos. This is the canonical source, kept in the
  main repo. CI (the `publish-chocolatey` job in .github/workflows/cd.yml) bumps
  <version> here and $url64/$checksum64 in tools/chocolateyinstall.ps1 on every
  release, then runs `choco pack` + `choco push`. The <version> below is a
  last-known-good template — CI overrides it per release.

    choco install talos

  Only Windows x86_64 is supported (the only published Windows release
  artifact: talos-v<version>-x86_64-pc-windows-msvc.zip). ARM64 Windows runs
  it under x64 emulation.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>talos</id>
    <version>0.79.46</version>
    <packageSourceUrl>https://github.com/Thurbeen/talos/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>LeTuR</owners>
    <title>talos (Coding-Agent TUI Orchestrator)</title>
    <authors>LeTuR</authors>
    <projectUrl>https://thurbeen.github.io/talos/</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/Thurbeen/talos@main/website/assets/logo-mark.png</iconUrl>
    <copyright>2026 LeTuR</copyright>
    <licenseUrl>https://github.com/Thurbeen/talos/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/Thurbeen/talos</projectSourceUrl>
    <docsUrl>https://github.com/Thurbeen/talos/blob/main/README.md</docsUrl>
    <bugTrackerUrl>https://github.com/Thurbeen/talos/issues</bugTrackerUrl>
    <tags>talos tui coding-agent orchestrator terminal cli claude codex aider developer-tools</tags>
    <summary>TUI for orchestrating multiple coding-agent CLI sessions in persistent panels.</summary>
    <description><![CDATA[
talos is a TUI for orchestrating multiple coding-agent CLI sessions
(claude, codex, gemini, opencode, aider, ...) in persistent multiplexer panels.
Sessions survive crashes/restarts because the multiplexer keeps the processes
alive.

**Note:** Windows support is experimental for now — it sees less testing than
Linux/macOS, so expect rough edges and please report issues.

This package installs the prebuilt x86_64 Windows release binaries
(`talos.exe` + `talos-cli.exe`) from the official GitHub Release and shims
them onto your PATH.

**Requirements not installed by this package:**

- [psmux](https://github.com/psmux/psmux) — the native-Windows terminal
  multiplexer talos drives (a drop-in tmux clone). There is no Chocolatey
  package for psmux, so it cannot be declared as a dependency here — install it
  separately.
- A coding-agent CLI (claude, codex, gemini, opencode, aider, ...) on your PATH.
    ]]></description>
    <releaseNotes>https://github.com/Thurbeen/talos/releases</releaseNotes>
    <!-- No <dependencies>: psmux has no Chocolatey package, so it can't be a
         hard dependency. It is documented in <description> instead. -->
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
