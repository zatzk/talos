<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reboot-proof automation firing for talos (macOS launchd user agent).

  OPT-IN, guaranteed alternative to talos's default tmux heartbeat keeper.
  Runs `talos-cli automation tick` every 60 seconds. Firing is claim-based,
  so it is safe alongside a live TUI and the tmux keeper.

  Install (macOS):
    cp packaging/launchd/dev.talos.automations.plist ~/Library/LaunchAgents/
    # edit the ProgramArguments path below if talos-cli is elsewhere
    launchctl load -w ~/Library/LaunchAgents/dev.talos.automations.plist

  Verify:   launchctl list | grep talos
  Unload:   launchctl unload -w ~/Library/LaunchAgents/dev.talos.automations.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.talos.automations</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with an absolute path, e.g. /Users/you/.local/bin/talos-cli -->
        <string>talos-cli</string>
        <string>automation</string>
        <string>tick</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/talos-automations.err.log</string>
</dict>
</plist>
