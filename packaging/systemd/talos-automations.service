# Reboot-proof automation firing for talos (systemd user service).
#
# This is the OPT-IN, guaranteed alternative to talos's default tmux
# heartbeat keeper. It runs `talos-cli automation tick` once per activation;
# the companion .timer drives the cadence. Firing is claim-based, so this is
# safe to run alongside a live TUI and the tmux keeper — no double-firing.
#
# Install (Linux):
#   mkdir -p ~/.config/systemd/user
#   cp packaging/systemd/talos-automations.{service,timer} ~/.config/systemd/user/
#   # adjust ExecStart below if talos-cli is not on PATH for systemd
#   systemctl --user daemon-reload
#   systemctl --user enable --now talos-automations.timer
#
# Verify:  systemctl --user list-timers | grep talos
# Logs:    journalctl --user -u talos-automations.service

[Unit]
Description=Fire due talos automations (headless)
Documentation=https://github.com/zatzk/talos

[Service]
Type=oneshot
# Use an absolute path if talos-cli is not on systemd's PATH, e.g.
#   ExecStart=%h/.local/bin/talos-cli automation tick
ExecStart=%h/.local/bin/talos-cli automation tick
